{
  "name": "o-generico",
  "version": "0.1.0",
  "private": true,
  "description": "O Genérico: plataforma de arquivo e análise de genéricos do cinema português",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:types": "astro check",
