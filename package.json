    "check:a11y": "node scripts/check-a11y.mjs",
    "check": "astro check && astro build && node scripts/check-links.mjs && node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^22.20.5",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
