---
import Logo from './Logo.astro';
import { sections } from '../lib/nav';
import { url } from '../lib/url';
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <p class="lead">
        Arquivo e análise de genéricos do cinema português. Um projeto de dissertação do Mestrado
        em Design e Multimédia da Universidade de Coimbra, com o apoio da Cinemateca Portuguesa –
        Museu do Cinema.
      </p>
      <nav aria-label="Secções">
        <ul>
          {
            sections.map((item) => (
              <li>
                <a href={url(item.path)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="mark">
      <Logo clipId="logo-rodape" />
    </div>
    <p class="caption bottom">
      <span>O Genérico © 2026</span>
      <span>FCTUC · Mestrado em Design e Multimédia</span>
    </p>
  </div>
</footer>

<script>
  import { morphLogo } from '../lib/logo-morph';

  // Genérico final: o "Og" abre-se no logótipo completo à medida que se chega ao fim da página.
  const svg = document.querySelector<SVGSVGElement>('.site-footer [data-logo]');
  if (svg && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const top = svg.getBoundingClientRect().top;
      const maxScroll = document.documentElement.scrollHeight - innerHeight;
      const topAtEnd = top + scrollY - maxScroll;
      const q = (innerHeight - top) / Math.max(1, Math.min(innerHeight * 0.5, innerHeight - topAtEnd));
      morphLogo(svg, 1 - Math.min(Math.max(q, 0), 1));
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .site-footer {
    padding-block: var(--space-7) var(--space-4);
    background: var(--color-night);
    color: var(--color-night-text);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 32rem) auto;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .lead {
    color: var(--color-night-muted);
  }

  ul {
    columns: 2;
    column-gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-block;
    padding-block: 0.2rem;
    font-family: var(--font-display);
    font-size: var(--text-heading);
    text-decoration: none;
  }

  li a:hover {
    font-style: italic;
  }

  /* O logótipo ocupa a largura toda; a altura fica reservada para a página não saltar */
  .mark {
    container-type: inline-size;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 6694 / 1021;
    margin-block: var(--space-7) var(--space-4);
  }

  .mark :global(.logo) {
    --k: calc(100cqi / 6694);
    width: calc(var(--vbw, 6694) * var(--k));
    height: calc(var(--vbh, 1021) * var(--k));
    max-width: none;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid rgba(245, 245, 243, 0.18);
    color: var(--color-night-muted);
  }

  @media (max-width: 47.99rem) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
