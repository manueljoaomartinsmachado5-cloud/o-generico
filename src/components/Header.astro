---
import Logo from './Logo.astro';
import { nav } from '../lib/nav';
import { url } from '../lib/url';

interface Props {
  // 'dark': começa transparente sobre uma capa escura (página inicial).
  tone?: 'dark' | 'light';
}

const { tone = 'light' } = Astro.props;
const current = Astro.url.pathname;
const isCurrent = (path: string) =>
  path === '/' ? current === url('/') : current.startsWith(url(path));
const groups = [nav.slice(0, 3), nav.slice(3)];
---

<header class="site-header" data-tone={tone}>
  <nav class="container bar" aria-label="Principal">
    {
      groups.map((items, i) => (
        <ul class:list={['group', i ? 'group--right' : 'group--left']}>
          {items.map((item) => (
            <li>
              <a href={url(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      ))
    }
    <a class="brand" href={url('/')}><Logo clipId="logo-cabecalho" /></a>
    <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="menu">
      Menu
    </button>
  </nav>

  <dialog id="menu" class="menu" aria-label="Menu">
    <button class="menu-close" type="button">Fechar</button>
    <ul>
      {
        nav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a href={url(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="caption">O Genérico © 2026</p>
  </dialog>
</header>

<script>
  import { ease, morphLogo } from '../lib/logo-morph';

  const header = document.querySelector<HTMLElement>('.site-header')!;
  const logo = header.querySelector<SVGSVGElement>('[data-logo]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // O logótipo recolhe nos primeiros ~40% do ecrã de scroll; o fundo fica sólido depois da capa.
  let ticking = false;
  let last = -1;
  function update() {
    ticking = false;
    const range = Math.min(innerHeight * 0.4, 360);
    const p = reduce.matches ? Number(scrollY > range / 2) : Math.min(scrollY / range, 1);
    if (p !== last) {
      last = p;
      morphLogo(logo, p);
      header.style.setProperty('--e', String(ease(p)));
    }
    const limit = hero ? hero.offsetHeight - header.offsetHeight : 8;
    header.classList.toggle('is-solid', scrollY > limit);
  }
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  addEventListener('resize', update);
  update();

  const menu = header.querySelector<HTMLDialogElement>('#menu')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  toggle.addEventListener('click', () => {
    menu.showModal();
    toggle.setAttribute('aria-expanded', 'true');
  });
  menu.querySelector('.menu-close')!.addEventListener('click', () => menu.close());
  menu.addEventListener('close', () => toggle.setAttribute('aria-expanded', 'false'));
</script>

<style>
  .site-header {
    /* Tamanho das letras: do logótipo completo ao "Og" (--e vem do script) */
    --logo-k: calc(clamp(10.5rem, 23vw, 21rem) / 6694);
    --logo-k-og: calc(clamp(3rem, 5.2vw, 4.75rem) / 1517);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--color-ink);
    transition:
      background-color 300ms ease,
      color 300ms ease,
      box-shadow 300ms ease;
  }

  /* Sobre a capa: fundo escuro translúcido que aparece com o scroll, para o texto da capa
     não se misturar com o menu; o anel de foco fica da cor do texto (o acento não contrasta com a foto). */
  .site-header[data-tone='dark']:not(.is-solid) {
    color: var(--color-night-text);
    background: rgba(11, 11, 11, calc(var(--e, 0) * 0.6));
    backdrop-filter: blur(calc(var(--e, 0) * 14px));
  }

  .site-header[data-tone='dark']:not(.is-solid) :focus-visible {
    outline-color: currentColor;
  }

  /* Sem JavaScript: o cabeçalho sai com a capa e o menu fica no rodapé */
  :global(html:not(.js)) .site-header {
    position: absolute;
  }

  :global(html:not(.js)) .menu-toggle {
    display: none;
  }

  .site-header.is-solid {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 1px 0 var(--color-line);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: calc(1.75rem - 0.9rem * var(--e, 0));
  }

  .group {
    display: flex;
    gap: clamp(1.5rem, 3.6vw, 4.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group--left {
    grid-column: 1;
    grid-row: 1;
  }

  .group--right {
    grid-column: 3;
    grid-row: 1;
    justify-content: flex-end;
  }

  .group a,
  .menu-toggle {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.75rem + 0.6vw, 1.3rem);
    letter-spacing: -0.01em;
    text-decoration: none;
    color: inherit;
  }

  /* Sublinhado que se desenha da esquerda para a direita */
  .group a {
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    padding-bottom: 2px;
    transition: background-size 400ms var(--ease-out);
  }

  .group a:hover,
  .group a[aria-current='page'] {
    background-size: 100% 1px;
  }

  .brand {
    grid-column: 2;
    grid-row: 1;
    color: inherit;
  }

  .brand :global(.logo) {
    --k: calc(var(--logo-k) + (var(--logo-k-og) - var(--logo-k)) * var(--e, 0));
    width: calc(var(--vbw, 6694) * var(--k));
    height: calc(var(--vbh, 1021) * var(--k));
    max-width: none;
  }

  .menu-toggle {
    display: none;
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    padding: var(--space-2) 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  @media (max-width: 61.99rem) {
    .group {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }

  /* Menu em ecrã inteiro (telemóvel e tablet) */
  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--space-4) var(--gutter);
    border: 0;
    background: var(--color-night);
    color: var(--color-night-text);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  .menu-close {
    align-self: flex-end;
    padding: var(--space-2) 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-display);
    font-size: 1.125rem;
    cursor: pointer;
  }

  .menu ul {
    margin: auto 0;
    padding: 0;
    list-style: none;
  }

  .menu li {
    animation: rise 600ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms + 60ms);
  }

  .menu a {
    display: block;
    padding-block: 0.15em;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 11vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .menu a[aria-current='page'] {
    font-style: italic;
  }

  .menu .caption {
    color: var(--color-night-muted);
  }

  :global(html:has(.menu[open])) {
    overflow: hidden;
  }
</style>
