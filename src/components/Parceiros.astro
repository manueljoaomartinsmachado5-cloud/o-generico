---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Para mostrar um logótipo: pôr o ficheiro (SVG ou PNG) em src/assets/parceiros/,
// importá-lo aqui e passá-lo em `logo`. Sem logótipo, aparece o nome.
const parceiros: { nome: string; logo?: ImageMetadata }[] = [
  { nome: 'Universidade de Coimbra' },
  { nome: 'Faculdade de Ciências e Tecnologia da Universidade de Coimbra' },
  { nome: 'Cinemateca Portuguesa – Museu do Cinema' },
];
---

<section class="parceiros" aria-labelledby="parceiros-titulo">
  <div class="container grid">
    <h2 id="parceiros-titulo" class="caption">Parceiros</h2>
    <ul>
      {
        parceiros.map((p) => (
          <li>{p.logo ? <Image src={p.logo} alt={p.nome} height={128} /> : <span>{p.nome}</span>}</li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .parceiros {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: center;
  }

  h2 {
    grid-column: 1 / 4;
    color: var(--color-graphite);
  }

  ul {
    grid-column: 4 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    place-items: center;
    min-height: 6rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--color-panel);
    text-align: center;
  }

  li span {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
  }

  /* Logótipos a preto e branco: a cor fica para os genéricos */
  li :global(img) {
    width: auto;
    max-height: 3.5rem;
    filter: grayscale(1);
  }

  @media (max-width: 61.99rem) {
    h2,
    ul {
      grid-column: 1 / -1;
    }
  }
</style>
