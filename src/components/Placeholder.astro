---
// Conteúdo provisório das secções que ainda não foram construídas.
interface Props {
  title: string;
  phase: string;
}

const { title, phase } = Astro.props;
---

<section class="container placeholder">
  <p class="eyebrow">Em construção · {phase}</p>
  <h1>{title}</h1>
  <slot />
</section>

<style>
  .placeholder {
    padding-block: var(--space-6);
  }

  h1 {
    font-size: var(--text-xl);
  }
</style>
