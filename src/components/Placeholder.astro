---
// Página simples: secções que ainda não foram construídas e erros.
interface Props {
  title: string;
  label?: string;
}

const { title, label = 'Em construção' } = Astro.props;
---

<section class="container placeholder">
  <p class="caption" data-reveal>{label}</p>
  <h1 data-reveal style="--delay: 1">{title}</h1>
  <div class="text" data-reveal style="--delay: 2"><slot /></div>
</section>

<style>
  .placeholder {
    padding-block: calc(var(--header-h) + var(--space-7)) var(--space-7);
  }

  .caption {
    color: var(--color-graphite);
  }

  h1 {
    margin-block: var(--space-4) var(--space-5);
    font-size: clamp(3.5rem, 1.5rem + 9vw, 10rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .text {
    max-width: var(--width-text);
    font-size: var(--text-heading);
    line-height: 1.35;
    color: var(--color-graphite);
  }

  .text :global(p + p) {
    margin-top: var(--space-3);
  }
</style>
