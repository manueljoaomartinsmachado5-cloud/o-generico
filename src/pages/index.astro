---
import { getCollection, getEntries } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const tagline =
  'Uma plataforma digital para explorar, comparar e contextualizar a abertura visual do cinema português';

const manifesto =
  'A sequência de abertura de um filme apresenta o título, o elenco e a equipa criativa. Mas também estabelece o tom e a atmosfera da obra.';
const words = manifesto.split(' ');
const marked = words.indexOf('tom') - 1; // "o tom e a atmosfera da obra." fica sublinhado a lima

const genericos = await Promise.all(
  (await getCollection('genericos'))
    .sort((a, b) => a.data.ano - b.data.ano)
    .map(async ({ data }) => ({
      ...data,
      realizacao: (await getEntries(data.realizacao)).map((p) => p.data.nome).join(', '),
    })),
);

// As quatro formas do "Og" (O, meio disco, ponto e triângulo do G), em unidades da fonte.
const formas = [
  { d: 'M237 -350a360 360 0 1 0 720 0a360 360 0 1 0 -720 0Z', cor: 'coral' },
  { d: 'M1369 10A360 360 0 0 1 1369 -710Z', cor: 'lime' },
  { d: 'M1419 -542.5a167.5 167.5 0 1 0 335 0a167.5 167.5 0 1 0 -335 0Z', cor: 'pink' },
  { d: 'M1419 -325H1744V0Z', cor: 'sun' },
];

const elementos = [
  {
    nome: 'Tipografia',
    texto: 'As letras do título e dos créditos, e a forma como entram e saem.',
  },
  {
    nome: 'Composição gráfica',
    texto: 'Onde cada elemento se coloca no ecrã e como se relaciona com os outros.',
  },
  { nome: 'Animação', texto: 'O movimento das letras, das formas e das imagens.' },
  { nome: 'Ritmo', texto: 'A duração de cada crédito e o compasso dos cortes.' },
  { nome: 'Som', texto: 'A música, o silêncio e os ruídos que acompanham a abertura.' },
];

// Alturas fixas das barras de som (0–1), para o desenho ser igual em todas as compilações.
const onda = [0.35, 0.6, 0.9, 0.5, 0.75, 1, 0.65, 0.4, 0.8, 0.55, 0.95, 0.45, 0.7, 0.3, 0.85, 0.6, 0.4, 0.75];

const entradas = [
  {
    label: 'Arquivo',
    path: '/arquivo/',
    text: 'Todos os genéricos catalogados, com pesquisa e filtros.',
  },
  {
    label: 'Linha temporal',
    path: '/linha-temporal/',
    text: 'Os genéricos no tempo: tendências, influências e mudanças.',
  },
  {
    label: 'Autores',
    path: '/autores/',
    text: 'Designers, realizadores, animadores e estúdios.',
  },
  {
    label: 'Explorar',
    path: '/explorar/',
    text: 'Relações entre genéricos, a partir de qualquer obra.',
  },
];
---

<Base>
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="caption kicker">Arquivo e análise de genéricos do cinema português</p>
        <h1 id="hero-titulo" class="hero-title">
          {
            tagline.split(' ').map((w, i) => (
              <>
                <span class="wm">
                  <span style={`--i: ${i}`}>{w}</span>
                </span>{' '}
              </>
            ))
          }
        </h1>
        <div class="actions">
          <a class="button button--accent" href={url('/arquivo/')}>
            Explorar o arquivo <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="button button--ghost" href="#elementos">Do que é feito um genérico</a>
        </div>
      </div>

      <div class="stage" data-stage>
        <div class="stage-bar caption">
          <span class="stage-name"><span class="frame-icon" aria-hidden="true">#</span> Abertura</span>
          <span class="tc" data-tc aria-hidden="true">00:00:00:00</span>
          <button type="button" class="replay" data-replay>Repetir</button>
        </div>
        <div class="screen is-playing" data-screen aria-hidden="true">
          <svg viewBox="-304.5 -1065 2600 1625">
            {
              formas.map((f, i) => (
                <g class="par" style={`--depth: ${[60, 90, 130, 110][i]}`}>
                  <path class="shape" d={f.d} style={`--i: ${i}; fill: var(--color-${f.cor})`} />
                </g>
              ))
            }
          </svg>
          <p class="credits">Tipografia · Composição · Animação · Ritmo · Som</p>
        </div>
        <div class="cursors" aria-hidden="true">
          <span class="cursor" style="--x: 4%; --y: 26%; --c: var(--color-coral); --depth: 18; --i: 0">
            <svg viewBox="0 0 16 16"><path d="M1 1 15 7.5 8.5 9 6.5 15Z"></path></svg>
            <span>Tipografia</span>
          </span>
          <span class="cursor" style="--x: 86%; --y: 46%; --c: var(--color-lime); --depth: -14; --i: 1">
            <svg viewBox="0 0 16 16"><path d="M1 1 15 7.5 8.5 9 6.5 15Z"></path></svg>
            <span>Ritmo</span>
          </span>
          <span class="cursor cursor--som" style="--x: 64%; --y: 74%; --c: var(--color-pink); --depth: 24; --i: 2">
            <svg viewBox="0 0 16 16"><path d="M1 1 15 7.5 8.5 9 6.5 15Z"></path></svg>
            <span>Som</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <span class="marquee-group">
            {elementos.map((e, i) => (
              <>
                <span class="marquee-item">{e.nome}</span>
                <svg class="marquee-shape" viewBox={['237 -710 720 720', '1009 -710 360 720', '1419 -710 335 335', '1419 -325 325 325'][i % 4]}>
                  <path d={formas[i % 4].d} />
                </svg>
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <section class="manifesto" id="o-que-e" aria-labelledby="manifesto-titulo">
    <div class="container manifesto-grid">
      <h2 id="manifesto-titulo" class="caption label">O que é um genérico</h2>
      <p class="manifesto-text" data-words style={`--n: ${words.length}`}>
        {
          words.map((w, i) => (
            <span class:list={['w', i >= marked && 'mark']} style={`--i: ${i}`}>
              {w}{' '}
            </span>
          ))
        }
      </p>
      <p class="manifesto-aside" data-reveal>
        O tom constrói-se com a tipografia, a composição gráfica, a animação, o ritmo e o som. O
        Genérico reúne, estuda e relaciona os genéricos do cinema português enquanto objetos de
        design.
      </p>
    </div>
  </section>

  <section class="elements" id="elementos" aria-labelledby="elementos-titulo">
    <div class="container">
      <h2 id="elementos-titulo" class="section-title" data-reveal>Do que é feito um genérico</h2>
      <ul class="bento">
        <li class="el el--tipo" data-reveal>
          <div class="el-visual" aria-hidden="true">
            <span class="spec"><span>Aa</span><span>Aa</span></span>
          </div>
          <h3>{elementos[0].nome}</h3>
          <p>{elementos[0].texto}</p>
        </li>
        <li class="el el--comp" data-reveal style="--delay: 1">
          <div class="el-visual" aria-hidden="true">
            <span class="blk"></span><span class="blk"></span><span class="blk"></span><span class="blk"></span>
          </div>
          <h3>{elementos[1].nome}</h3>
          <p>{elementos[1].texto}</p>
        </li>
        <li class="el el--anim" data-reveal>
          <div class="el-visual" aria-hidden="true"><span class="ball"></span><span class="floor"></span></div>
          <h3>{elementos[2].nome}</h3>
          <p>{elementos[2].texto}</p>
        </li>
        <li class="el el--ritmo" data-reveal style="--delay: 1">
          <div class="el-visual" aria-hidden="true">
            {[3, 1.5, 2, 1, 2.5, 1.2].map((w) => <span class="clip" style={`flex-grow: ${w}`} />)}
            <span class="head"></span>
          </div>
          <h3>{elementos[3].nome}</h3>
          <p>{elementos[3].texto}</p>
        </li>
        <li class="el el--som" data-reveal style="--delay: 2">
          <div class="el-visual" aria-hidden="true">
            {onda.map((h, i) => <span class="bar" style={`--h: ${h}; --i: ${i}`} />)}
          </div>
          <h3>{elementos[4].nome}</h3>
          <p>{elementos[4].texto}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="featured" aria-labelledby="destaques-titulo" data-carousel>
    <div class="container featured-head">
      <h2 id="destaques-titulo" class="section-title">Genéricos em destaque</h2>
      <p class="caption note">Exemplos provisórios, até entrarem os primeiros genéricos do arquivo</p>
      <div class="controls">
        <button type="button" class="round" data-prev aria-controls="destaques" aria-label="Anterior">←</button>
        <button type="button" class="round" data-next aria-controls="destaques" aria-label="Seguinte">→</button>
      </div>
    </div>
    <ul class="track" id="destaques" tabindex="0" aria-label="Genéricos em destaque">
      {
        genericos.map((g, i) => (
          <li class="slide">
            <article aria-labelledby={`destaque-${i}`}>
              <div class:list={['frame', `frame--${i % 3}`]} aria-hidden="true">
                <span class="tag">Exemplo fictício</span>
                <span class="frame-credit">Um filme de {g.realizacao}</span>
                <span class="frame-title">{g.titulo}</span>
                <span class="frame-year">{g.ano}</span>
                <svg class="frame-shapes" viewBox="237 -710 1517 720">
                  {formas.map((f) => (
                    <path d={f.d} />
                  ))}
                </svg>
              </div>
              <div class="slide-meta">
                <h3 id={`destaque-${i}`}>{g.titulo}</h3>
                <span>{g.ano}</span>
              </div>
              <p class="caption slide-info">
                {g.realizacao} · {g.tecnicas.join(', ')}
              </p>
            </article>
          </li>
        ))
      }
    </ul>
    <div class="container">
      <div class="progress" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="entries" aria-labelledby="entradas-titulo">
    <div class="container">
      <h2 id="entradas-titulo" class="section-title" data-reveal>Por onde começar</h2>
      <ul class="cards">
        {
          entradas.map((e, i) => (
            <li data-reveal style={`--delay: ${i}`}>
              <a class:list={['card', `card--${i}`]} href={url(e.path)}>
                <span class="caption">0{i + 1}</span>
                <span class:list={['shape-mini', `shape-mini--${i}`]} aria-hidden="true" />
                <span class="card-title">{e.label}</span>
                <span class="card-text">{e.text}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="project" aria-labelledby="projeto-titulo">
    <div class="container">
      <div class="project-panel">
        <div data-reveal>
          <h2 id="projeto-titulo" class="section-title">O projeto</h2>
          <p class="project-text">
            O Genérico é um projeto de dissertação do Mestrado em Design e Multimédia da Faculdade
            de Ciências e Tecnologia da Universidade de Coimbra, com o apoio da Cinemateca
            Portuguesa – Museu do Cinema.
          </p>
          <a class="button button--ghost" href={url('/sobre/')}>
            Sobre o projeto <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <dl class="facts">
          <div data-reveal style="--delay: 1">
            <dt class="caption">Mestrado</dt>
            <dd>Design e Multimédia</dd>
          </div>
          <div data-reveal style="--delay: 2">
            <dt class="caption">Instituição</dt>
            <dd>FCTUC, Universidade de Coimbra</dd>
          </div>
          <div data-reveal style="--delay: 3">
            <dt class="caption">Apoio</dt>
            <dd>Cinemateca Portuguesa – Museu do Cinema</dd>
          </div>
          <div data-reveal style="--delay: 4">
            <dt class="caption">Ano letivo</dt>
            <dd>2026/2027</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pad = (n: number) => String(n).padStart(2, '0');

    // Capa: a abertura (as formas montam o "Og") toca uma vez; "Repetir" volta a tocá-la.
    // O código de tempo conta só enquanto toca, para nada se mexer sozinho mais de 5 s.
    const stage = document.querySelector<HTMLElement>('[data-stage]')!;
    const screen = stage.querySelector<HTMLElement>('[data-screen]')!;
    const tc = stage.querySelector<HTMLElement>('[data-tc]')!;
    const LENGTH = 2800;
    let raf = 0;
    const play = () => {
      screen.classList.remove('is-playing');
      void screen.offsetWidth; // recomeça as animações CSS
      screen.classList.add('is-playing');
      cancelAnimationFrame(raf);
      let t0 = -1;
      const tick = (t: number) => {
        if (t0 < 0) t0 = t;
        const ms = reduce ? LENGTH : Math.min(t - t0, LENGTH);
        const f = Math.floor((ms * 24) / 1000);
        tc.textContent = `00:00:${pad(Math.floor(f / 24))}:${pad(f % 24)}`;
        if (ms < LENGTH) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };
    stage.querySelector('[data-replay]')!.addEventListener('click', play);
    play();

    // As formas e os cursores seguem o rato com profundidades diferentes (só quando o rato se mexe).
    if (!reduce) {
      let ticking = false;
      let mx = 0;
      let my = 0;
      addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        mx = (e.clientX / innerWidth) * 2 - 1;
        my = (e.clientY / innerHeight) * 2 - 1;
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          stage.style.setProperty('--mx', mx.toFixed(3));
          stage.style.setProperty('--my', my.toFixed(3));
        });
      });
    }

    // Faixa: desliza com o scroll.
    const marquee = document.querySelector<HTMLElement>('.marquee-track');
    let half = 0;
    const measure = () => (half = (marquee?.scrollWidth ?? 0) / 2);
    let ticking = false;
    const slide = () => {
      ticking = false;
      if (marquee && half && !reduce) marquee.style.transform = `translateX(${-((scrollY * 0.4) % half)}px)`;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(slide);
        }
      },
      { passive: true },
    );
    addEventListener('resize', measure);
    document.fonts.ready.then(measure);
    measure();

    // Carrossel: scroll nativo (toque, trackpad, teclado) + botões e barra de progresso.
    for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
      const track = root.querySelector<HTMLElement>('.track')!;
      const thumb = root.querySelector<HTMLElement>('.progress span')!;
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
      const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
      const step = (dir: number) =>
        track.scrollBy({
          left: dir * (track.querySelector('li')?.offsetWidth ?? 0),
          behavior: reduce ? 'auto' : 'smooth',
        });
      prev.addEventListener('click', () => step(-1));
      next.addEventListener('click', () => step(1));

      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        const frac = track.clientWidth / track.scrollWidth;
        const p = max > 0 ? track.scrollLeft / max : 0;
        thumb.style.width = `${frac * 100}%`;
        thumb.style.transform = `translateX(${p * (1 / frac - 1) * 100}%)`;
        // aria-disabled em vez de disabled, para o botão não perder o foco do teclado
        prev.setAttribute('aria-disabled', String(track.scrollLeft <= 1));
        next.setAttribute('aria-disabled', String(track.scrollLeft >= max - 1));
      };
      track.addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    }
  </script>
</Base>

<style>
  /* Capa: tela com grelha de pontos, como num canvas */
  .hero {
    padding-block: calc(var(--header-h) + var(--space-5)) var(--space-6);
    background:
      radial-gradient(circle at 1px 1px, rgba(10, 10, 10, 0.13) 1px, transparent 0) 0 0 / 24px 24px,
      var(--color-paper);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    min-height: calc(100svh - var(--header-h) - var(--space-5) - var(--space-6));
  }

  .kicker {
    color: var(--color-graphite);
    animation: rise 900ms var(--ease-out) 100ms both;
  }

  .hero-title {
    margin-block: var(--space-4) var(--space-5);
    font-size: clamp(2.4rem, 1.3rem + 3vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .wm {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }

  .wm > span {
    display: inline-block;
    animation: word-in 1s var(--ease-out) both;
    animation-delay: calc(var(--i) * 45ms + 200ms);
  }

  @keyframes word-in {
    from {
      transform: translateY(105%);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    animation: rise 900ms var(--ease-out) 900ms both;
  }

  .button--ghost {
    background: var(--color-paper);
  }

  /* Palco: um "frame" com nome, código de tempo e botão, como no Figma */
  .stage {
    position: relative;
    animation: rise 1s var(--ease-out) 300ms both;
  }

  .stage-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    color: var(--color-graphite);
  }

  .stage-name {
    margin-right: auto;
  }

  .frame-icon {
    color: var(--color-accent);
  }

  .tc {
    font-variant-numeric: tabular-nums;
  }

  .replay {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .replay:hover {
    border-color: var(--color-ink);
  }

  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    background: var(--color-accent);
    box-shadow: var(--shadow-float);
    overflow: hidden;
  }

  .screen svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .par {
    transform: translate(calc(var(--mx, 0) * var(--depth) * 1px), calc(var(--my, 0) * var(--depth) * 1px));
    transition: transform 900ms var(--ease-out);
  }

  .shape {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Cada forma entra de um lado diferente e encaixa no "Og" */
  .is-playing .shape {
    animation: assemble 1.1s cubic-bezier(0.2, 1.35, 0.4, 1) both;
    animation-delay: calc(var(--i) * 220ms + 250ms);
  }

  .is-playing .shape[style*='--i: 0'] {
    --from: translate(-900px, 300px) scale(0.2);
  }

  .is-playing .shape[style*='--i: 1'] {
    --from: translate(700px, -600px) rotate(180deg);
  }

  .is-playing .shape[style*='--i: 2'] {
    --from: translate(500px, -900px) scale(0.2);
  }

  .is-playing .shape[style*='--i: 3'] {
    --from: translate(900px, 500px) rotate(-90deg);
  }

  @keyframes assemble {
    from {
      opacity: 0;
      transform: var(--from);
    }
  }

  .credits {
    position: absolute;
    inset: auto 0 7%;
    color: #fff;
    font-size: var(--text-caption);
    letter-spacing: 0.3em;
    text-align: center;
    text-transform: uppercase;
  }

  .is-playing .credits {
    animation: rise 900ms var(--ease-out) 1.9s both;
  }

  /* Cursores de "colaboradores", com o nome de cada elemento do genérico */
  .cursors {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cursor {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: flex-start;
    gap: 2px;
    translate: calc(var(--mx, 0) * var(--depth) * 1px) calc(var(--my, 0) * var(--depth) * 1px);
    transition: translate 1.2s var(--ease-out);
    animation: cursor-in 1.2s var(--ease-out) both;
    animation-delay: calc(var(--i) * 300ms + 900ms);
  }

  @keyframes cursor-in {
    from {
      opacity: 0;
      transform: translate(-3rem, 2rem);
    }
  }

  .cursor svg {
    width: 1.1rem;
    fill: var(--c);
    stroke: var(--color-ink);
    stroke-width: 1;
  }

  .cursor span {
    margin-top: 0.9rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--c);
    color: var(--color-ink);
    font-size: var(--text-caption);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Faixa */
  .marquee {
    overflow: hidden;
    padding-block: var(--space-4);
    background: var(--color-lime);
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee-group {
    display: flex;
    align-items: center;
  }

  .marquee-item {
    padding-inline: var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .marquee-item:nth-child(4n + 3) {
    font-style: italic;
  }

  .marquee-shape {
    width: auto;
    height: clamp(1.5rem, 1rem + 2vw, 3.25rem);
    fill: var(--color-ink);
  }

